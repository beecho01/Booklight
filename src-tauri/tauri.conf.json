{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/2.x/core/tauri-config-schema/schema.json",
    "productName": "Booklight",
    "version": "0.1.0",
    "identifier": "uk.co.beecho01.booklight",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Booklight",
                "width": 1200,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "transparent": true,
                "decorations": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}
